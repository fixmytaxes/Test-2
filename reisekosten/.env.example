# Beispiel für den Versand-Server – als .env kopieren und ausfüllen (.env nie einchecken!)
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=reisekosten@example.de
SMTP_PASS=
MAIL_FROM=Reisekosten <reisekosten@example.de>
# Token, das in der App unter Einstellungen → Versand-Server eingetragen wird
APP_TOKEN=
# Erlaubte Empfänger (Adressen oder @domain), kommagetrennt
MAIL_ALLOWED_TO=@uploadmail.datev.de
MAIL_ALLOWED_EXTRA=
# Testbetrieb ohne echten Versand
MAIL_DRYRUN=0
PORT=8787
